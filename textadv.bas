#RetroDevStudio.MetaData.BASIC:2049,BASIC V2,uppercase,10,10
10 PRINT CHR$(147): REM CLEAR THE SCREEN
20 POKE 53280,2: REM RED BORDER
30 POKE 53281,0: REM BLACK BACKGROUND
40 POKE 646,5: REM GREEN TEXT
50 PRINT CHR$(30);"YOU ARE IN A SMALL ROOM."
60 PRINT CHR$(30);"A DOOR IS TO THE NORTH."
70 PRINT
80 PRINT CHR$(30);"WHAT DO YOU DO";
90 INPUT A$
100 IF A$ = "NORTH" THEN PRINT CHR$(30);"THE DOOR OPENS."
110 IF A$ <> "NORTH" THEN PRINT CHR$(30);"NOTHING HAPPENS."
120 PRINT
130 PRINT CHR$(30);"WHAT DO YOU DO";
140 INPUT B$
150 IF B$ = "LOOK" THEN PRINT CHR$(30);"THE ROOM IS EMPTY."
160 IF B$ <> "LOOK" THEN PRINT CHR$(30);"YOU WAIT."
170 PRINT
180 PRINT CHR$(30);"THE END."
181 PRINT
185 GOTO 50
190 END